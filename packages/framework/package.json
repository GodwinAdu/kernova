{
  "name": "@kernova/framework",
  "version": "2.0.0",
  "description": "Full-stack AI agent framework — frontend + agents in one project",
  "keywords": [
    "kernova",
    "ai",
    "agents",
    "framework",
    "full-stack",
    "react",
    "nextjs"
  ],
  "homepage": "https://kernova2026.vercel.app",
  "bugs": {
    "url": "https://github.com/GodwinAdu/kernova/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodwinAdu/kernova.git",
    "directory": "packages/framework"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc",
    "dev": "tsc --watch",
    "clean": "node ../../scripts/clean.mjs dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kernova/core": "^2.0.0",
    "@kernova/types": "^1.1.0"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^6.0.3"
  }
}
