{
  "name": "kernova",
  "version": "0.1.0",
  "private": true,
  "description": "The Full-Stack AI Agent Platform",
  "homepage": "https://github.com/GodwinAdu/kernova#readme",
  "bugs": {
    "url": "https://github.com/GodwinAdu/kernova/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodwinAdu/kernova.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:all": "npm run build:types && npm run build:core && npm run build:sdk && npm run build:framework && npm run build:cli",
    "build:types": "tsc --project packages/types/tsconfig.json",
    "build:core": "tsc --project packages/core/tsconfig.json",
    "build:sdk": "tsc --project packages/sdk/tsconfig.json",
    "build:framework": "tsc --project packages/framework/tsconfig.json",
    "build:cli": "tsc --project packages/cli/tsconfig.json",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo run clean",
    "publish:all": "npm run build && npm publish --workspace=packages/types && npm publish --workspace=packages/core && npm publish --workspace=packages/sdk && npm publish --workspace=packages/framework && npm publish --workspace=packages/cli && npm publish --workspace=packages/create-kernova-app && npm publish --workspace=packages/kernova"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.0",
    "turbo": "^2.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "npm@10.0.0"
}
